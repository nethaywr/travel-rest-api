PORT=3000
# WAJIB diganti di production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d
DB_PATH=./data/travel.db
# Batas waktu bayar setelah booking dibuat (menit)
BOOKING_HOLD_MINUTES=15
# Biaya tambahan per transaksi (Rp)
ADMIN_FEE=0
# Asal request yang diizinkan (pisahkan koma). Kosongkan = semua (hanya untuk development)
CORS_ORIGINS=
